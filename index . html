<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Poupe Hoje, Garanta Amanhã - Com Painel de Controlo</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,sans-serif}
body{background:#f5f5f0;color:#18181b;padding:20px}
.card{background:#fff;border:1px solid #e4e4e7;border-radius:16px;padding:20px;margin-bottom:16px;box-shadow:0 2px 8px rgba(0,0,0,0.04)}
h1{font-size:30px;font-weight:900;line-height:1.1}
h1 span{color:#7c3aed}
.green{background:#dcfce7;border:1px solid #86efac;color:#166534;padding:12px;border-radius:12px;margin:12px 0;font-weight:600}
input[type=range]{width:100%;height:8px;accent-color:#18181b}
button{padding:14px 24px;border-radius:999px;border:none;font-weight:700;cursor:pointer;font-size:15px}
.btn-black{background:#18181b;color:#fff}
.btn-white{background:#fff;color:#18181b;border:1px solid #e4e4e7}
.btn-purple{background:#7c3aed;color:#fff}
.item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f4f4f5;gap:10px}
.badge{display:inline-block;background:#18181b;color:#fff;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700}
#adminPanel{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:#f5f5f0;z-index:9999;overflow:auto;padding:20px}
.stat{font-size:28px;font-weight:900}
.stat-label{font-size:12px;color:#71717a;text-transform:uppercase;letter-spacing:0.05em}
.visita-item{background:#fafafa;border:1px solid #e4e4e7;border-radius:12px;padding:12px;margin-bottom:8px;font-size:13px}
</style>
</head>
<body>
<div style="max-width:640px;margin:0 auto">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
<h1>Poupe Hoje,<br><span>Garanta Amanhã</span></h1>
<button onclick="abrirAdmin()" style="padding:8px 12px;font-size:12px" class="btn-white">🔒 Admin</button>
</div>
<p style="margin-bottom:16px;color:#71717a;font-size:14px">Simulador Angola • <span id="contadorGlobal" class="badge">👁️ 117 visitas</span></p>

<div class="card">
<h3>Rendimento mensal bruto</h3>
<input type="range" id="renda" min="0" max="500000" step="1000" value="90000">
<div style="margin-top:8px">Valor: <b id="rendaVal">90.000 Kz</b></div>
<div style="font-size:13px;color:#71717a">INSS (3%): <b id="inssVal">2.700 Kz</b> | Líquido: <b id="liquidoVal">87.300 Kz</b></div>
</div>

<div class="card">
<h3>Despesas (começam em 0)</h3>
<div id="despesas"></div>
<div style="margin-top:12px;font-weight:800" id="totalDesp">Total: 0 Kz</div>
<div>Sobra: <b id="dispVal">87.300 Kz</b></div>
</div>

<div class="card">
<h3>Quanto guardas?</h3>
<input type="range" id="perc" min="0" max="100" value="10">
<span id="percVal">10%</span> -> Guardas <b id="poupVal"></b>
<br><br>
Guardado hoje: <input type="range" id="guard" min="0" max="500000" step="1000" value="0"> <b id="guardVal">0 Kz</b>
<br><br>
Horizonte: <input type="range" id="hor" min="1" max="30" value="10"> <b id="horVal">10 anos</b>
</div>

<div class="card">
<h3>Perfil</h3>
<button id="btn-cons" onclick="setPerfil('conservador')">Conservador 6%</button>
<button id="btn-eq" onclick="setPerfil('equilibrado')" style="background:#18181b;color:#fff">Equilibrado 13%</button>
<button id="btn-ar" onclick="setPerfil('arrojado')">Arrojado 20%</button>
<div style="margin-top:12px">Projeção em <span id="horLabel">10</span> anos a <span id="taxaLabel">13</span>%: <b id="projVal" style="font-size:24px;color:#7c3aed"></b></div>
</div>

<div class="card">
<button class="btn-black" onclick="calc()">CALCULAR REALIDADE</button>
<button class="btn-white" onclick="reporPadrao()" style="margin-left:8px">REPÔR PADRÃO</button>
<div class="green">✅ Versão com Painel de Controlo de Dispositivos</div>
</div>

<div class="card" style="border:1px dashed #7c3aed">
<h4>🔒 Para o Dono</h4>
<p style="font-size:13px;color:#71717a">Clica em Admin no topo, senha padrão: <b>1234</b> - você pode mudar no código.</p>
<p style="font-size:12px;margin-top:6px">Este dispositivo atual: <b id="meuDevice">...</b></p>
</div>
</div>

<!-- PAINEL ADMIN -->
<div id="adminPanel">
<div style="max-width:640px;margin:0 auto">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
<h1>Painel Admin 🔒</h1>
<button onclick="fecharAdmin()" class="btn-black">Fechar X</button>
</div>

<div id="loginAdmin" class="card">
<h3>Digite a senha</h3>
<p style="font-size:13px;color:#71717a;margin:8px 0">Senha padrão: 1234</p>
<input id="senhaInput" type="password" placeholder="Senha" style="width:100%;padding:14px;border-radius:12px;border:1px solid #e4e4e7;margin:10px 0">
<button onclick="verificarSenha()" class="btn-purple" style="width:100%">Entrar no Painel</button>
<p id="erroSenha" style="color:red;font-size:13px;display:none;margin-top:8px">Senha errada!</p>
</div>

<div id="conteudoAdmin" style="display:none">
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
<div class="card"><div class="stat-label">Total de Visitas (Neste PC)</div><div class="stat" id="statTotal">0</div></div>
<div class="card"><div class="stat-label">Visitas Hoje</div><div class="stat" id="statHoje">0</div></div>
<div class="card"><div class="stat-label">Celulares</div><div class="stat" id="statMobile">0</div></div>
<div class="card"><div class="stat-label">Computadores</div><div class="stat" id="statPC">0</div></div>
</div>

<div class="card">
<h3>Visitas Registradas Neste Navegador</h3>
<p style="font-size:12px;color:#71717a;margin:8px 0">Cada vez que alguém abre sua APP neste mesmo celular/PC, registra aqui. Para controle GLOBAL de todos os dispositivos, use o GitHub Traffic + bit.ly</p>
<div id="listaVisitas"></div>
<button onclick="limparVisitas()" class="btn-white" style="margin-top:10px;font-size:12px">Limpar Histórico</button>
</div>

<div class="card">
<h3>Controle Global (GitHub)</h3>
<p style="font-size:13px;line-height:1.5">
✅ <b>117 Views</b> nos últimos 14 dias (você já tem)<br>
✅ <b>2 visitantes únicos</b><br>
✅ <b>71 views vindo do Meta AI</b><br><br>
Para ter controle REAL de todos os celulares que entrarem, faça isso:<br><br>
1. Vá no <b>bit.ly</b> e crie uma conta grátis<br>
2. Encurte seu link: <code>https://tomaschiteva19-beep.github.io/poupe-hoje/</code><br>
3. O bit.ly vai te mostrar: cidade, celular (Android/iPhone), hora exata<br>
4. É melhor que o GitHub!
</p>
</div>

<div class="card" style="background:#18181b;color:#fff">
<h3 style="color:#fff">Como bloquear dispositivo?</h3>
<p style="font-size:13px;margin-top:8px;color:#a1a1aa">Se quiser que só quem tem senha entre na APP, eu posso adicionar senha na entrada da APP. Me diga e eu atualizo. Senha atual do Admin: 1234 (mude no código na linha: const SENHA_ADMIN = '1234')</p>
</div>
</div>
</div>
</div>

<script>
const SENHA_ADMIN = '1234';
let despesas={habitacao:0,alimentacao:0,transporte:0,educacao:0,saude:0,lazer:0,vestuario:0,outros:0};
const cats=[{k:'habitacao',l:'🏠 Habitação',max:30000},{k:'alimentacao',l:'🍽️ Alimentação',max:15000},{k:'transporte',l:'🚗 Transporte',max:12000},{k:'educacao',l:'🎓 Educação',max:10000},{k:'saude',l:'🏥 Saúde',max:8000},{k:'lazer',l:'🎮 Lazer',max:10000},{k:'vestuario',l:'👕 Vestuário',max:6000},{k:'outros',l:'📱 Outros',max:10000}];
let renda=90000,guard=0,perc=10,hor=10,perfil='equilibrado',taxas={conservador:6,equilibrado:13,arrojado:20};
function fmt(v){return new Intl.NumberFormat('pt-AO',{maximumFractionDigits:0}).format(v)+' Kz'}

function detectarDevice(){
 const ua = navigator.userAgent;
 let device = 'PC';
 if(/Android/i.test(ua)) device = 'Android';
 else if(/iPhone|iPad|iPod/i.test(ua)) device = 'iPhone';
 else if(/Mobile/i.test(ua)) device = 'Celular';
 let navegador = 'Desconhecido';
 if(ua.includes('Chrome')) navegador='Chrome';
 else if(ua.includes('Firefox')) navegador='Firefox';
 else if(ua.includes('Safari')) navegador='Safari';
 return {device, navegador, ua: ua.substring(0,80)};
}

function registrarVisita(){
 const agora = new Date();
 const info = detectarDevice();
 document.getElementById('meuDevice').textContent = info.device + ' - ' + info.navegador;
 const visitas = JSON.parse(localStorage.getItem('visitas_poupe_hoje')||'[]');
 const novaVisita = {
   data: agora.toLocaleString('pt-AO'),
   dataISO: agora.toISOString().split('T')[0],
   hora: agora.toLocaleTimeString('pt-AO'),
   device: info.device,
   navegador: info.navegador,
   idioma: navigator.language
 };
 visitas.push(novaVisita);
 localStorage.setItem('visitas_poupe_hoje', JSON.stringify(visitas));
 // contador total local
 let total = parseInt(localStorage.getItem('contador_total')||'0')+1;
 localStorage.setItem('contador_total', total);
 document.getElementById('contadorGlobal').textContent = '👁️ ' + (117 + total) + ' visitas (GitHub 117 + local '+total+')';
 return visitas;
}

function renderDespesas(){const c=document.getElementById('despesas');c.innerHTML='';cats.forEach(cat=>{const div=document.createElement('div');div.className='item';div.innerHTML=`<span>${cat.l} - ${fmt(despesas[cat.k])}</span>`;const wr=document.createElement('div');wr.style.width='50%';const inp=document.createElement('input');inp.type='range';inp.min=0;inp.max=cat.max;inp.step=100;inp.value=despesas[cat.k];inp.oninput=e=>{despesas[cat.k]=+e.target.value;calc()};wr.appendChild(inp);div.appendChild(wr);c.appendChild(div)})}
function calc(){const inss=Math.round(renda*0.03);const liquido=renda-inss;const total=Object.values(despesas).reduce((a,b)=>a+b,0);const disp=liquido-total;const poupAnual=Math.max(0,disp*perc/100);const poupMens=poupAnual/12;const taxa=taxas[perfil];const vfGuard=guard*Math.pow(1+taxa/100,hor);const vfPoup=taxa===0?poupAnual*hor:poupAnual*((Math.pow(1+taxa/100,hor)-1)/(taxa/100));const proj=Math.round(vfGuard+vfPoup);
document.getElementById('rendaVal').textContent=fmt(renda);document.getElementById('inssVal').textContent=fmt(inss);document.getElementById('liquidoVal').textContent=fmt(liquido);document.getElementById('totalDesp').textContent='Total despesas: '+fmt(total)+' (começa em 0)';document.getElementById('percVal').textContent=perc+'%';document.getElementById('horVal').textContent=hor+' anos';document.getElementById('guardVal').textContent=fmt(guard);document.getElementById('dispVal').textContent=fmt(disp);document.getElementById('poupVal').textContent=fmt(poupMens)+'/mês';document.getElementById('horLabel').textContent=hor;document.getElementById('taxaLabel').textContent=taxa;document.getElementById('projVal').textContent=fmt(proj);
document.querySelectorAll('[id^="btn-"]').forEach(b=>{b.style.background='#fff';b.style.color='#18181b';b.style.border='1px solid #e4e4e7'});const ab=document.getElementById(perfil==='conservador'?'btn-cons':perfil==='equilibrado'?'btn-eq':'btn-ar');if(ab){ab.style.background='#18181b';ab.style.color='#fff'}
renderDespesas();localStorage.setItem('poupe-hoje-final',JSON.stringify({renda,guard,perc,hor,perfil,despesas}));}
function setPerfil(p){perfil=p;calc()}
function reporPadrao(){
localStorage.removeItem('poupe-hoje-final');
despesas={habitacao:0,alimentacao:0,transporte:0,educacao:0,saude:0,lazer:0,vestuario:0,outros:0};
renda=90000;guard=0;perc=10;hor=10;perfil='equilibrado';
document.getElementById('renda').value=90000;
document.getElementById('perc').value=10;
document.getElementById('hor').value=10;
document.getElementById('guard').value=0;
calc();
alert('✅ REPÔS!');
}

// ADMIN
function abrirAdmin(){document.getElementById('adminPanel').style.display='block';atualizarAdmin()}
function fecharAdmin(){document.getElementById('adminPanel').style.display='none'}
function verificarSenha(){
 const s = document.getElementById('senhaInput').value;
 if(s===SENHA_ADMIN){
   document.getElementById('loginAdmin').style.display='none';
   document.getElementById('conteudoAdmin').style.display='block';
   atualizarAdmin();
 } else {
   document.getElementById('erroSenha').style.display='block';
 }
}
function atualizarAdmin(){
 const visitas = JSON.parse(localStorage.getItem('visitas_poupe_hoje')||'[]');
 const hoje = new Date().toISOString().split('T')[0];
 document.getElementById('statTotal').textContent = visitas.length;
 document.getElementById('statHoje').textContent = visitas.filter(v=>v.dataISO===hoje).length;
 document.getElementById('statMobile').textContent = visitas.filter(v=>v.device!=='PC').length;
 document.getElementById('statPC').textContent = visitas.filter(v=>v.device==='PC').length;
 const lista = document.getElementById('listaVisitas');
 lista.innerHTML = '';
 if(visitas.length===0){lista.innerHTML='<p style="color:#71717a;font-size:12px">Nenhuma visita registrada ainda.</p>'}
 else {
   visitas.slice().reverse().slice(0,50).forEach(v=>{
     const div=document.createElement('div');div.className='visita-item';
     div.innerHTML=`<b>${v.data}</b> - ${v.hora}<br>📱 ${v.device} | 🌐 ${v.navegador} | 🗣️ ${v.idioma}`;
     lista.appendChild(div);
   });
 }
}
function limparVisitas(){if(confirm('Limpar todo histórico de visitas deste aparelho?')){localStorage.removeItem('visitas_poupe_hoje');localStorage.removeItem('contador_total');atualizarAdmin();alert('Limpo!')}}

document.getElementById('renda').oninput=e=>{renda=+e.target.value;calc()};
document.getElementById('perc').oninput=e=>{perc=+e.target.value;calc()};
document.getElementById('hor').oninput=e=>{hor=+e.target.value;calc()};
document.getElementById('guard').oninput=e=>{guard=+e.target.value;calc()};
const saved=localStorage.getItem('poupe-hoje-final');if(saved){try{const d=JSON.parse(saved);if(d.renda)renda=d.renda;if(d.guard!==undefined)guard=d.guard;if(d.perc)perc=d.perc;if(d.hor)hor=d.hor;if(d.perfil)perfil=d.perfil;if(d.despesas)despesas=d.despesas;document.getElementById('renda').value=renda;document.getElementById('perc').value=perc;document.getElementById('hor').value=hor;document.getElementById('guard').value=guard}catch{}}
registrarVisita();
calc();
</script>
</body>
</html>
